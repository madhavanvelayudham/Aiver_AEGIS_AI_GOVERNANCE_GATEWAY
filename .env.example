# AEGIS Environment Configuration
# Copy to .env and modify as needed

# Database
DATABASE_URL=sqlite+aiosqlite:///./aegis.db

# Business Hours (UTC)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_HOURS_TIMEZONE=UTC

# Governance
VIOLATION_THRESHOLD=3
HITL_EXPIRY_MINUTES=60
DEFAULT_POLICY_ID=base_policy

# LLM Provider
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Server
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
